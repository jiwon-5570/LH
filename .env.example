APP_ENV=development
DATABASE_URL=postgresql+psycopg://lh_predict:change_me@db:5432/lh_predict
FRONTEND_API_URL=http://backend:8000
# NAVER Cloud Platform Maps > Application의 Web Dynamic Map Client ID(ncpKeyId)
# Web 서비스 URL 등록 예: http://127.0.0.1:8501, http://localhost:8501
# Client Secret은 브라우저 지도 코드나 이 항목에 입력하지 않습니다.
NAVER_MAP_CLIENT_ID=
# 서버 측 NAVER Maps API(지오코딩 등)에 사용하는 인증키/Client Secret
# 브라우저 HTML이나 JavaScript에는 절대 전달하지 않습니다.
NAVER_MAP_CLIENT_SECRET=
# 신규 Maps API: ncpKeyId / 기존 Maps API: ncpClientId
NAVER_MAP_AUTH_PARAM=ncpKeyId
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
DATA_GO_KR_SERVICE_KEY=
KMA_SERVICE_KEY=
SEOUL_RAINFALL_API_KEY=
SEOUL_SEWER_LEVEL_API_KEY=
SEOUL_FLOOD_FORECAST_MAP_API_KEY=
# 아래 3개 키는 데이터셋별로 발급된 실제 키를 각각 입력합니다.
SEOUL_RAIN_GAUGE_LOCATION_API_KEY=
SEOUL_PUMP_STATION_ATTRIBUTE_API_KEY=
SEOUL_RIVER_LEVEL_API_KEY=

# 데이터셋별 API URL은 발급/승인된 실제 엔드포인트를 입력합니다.
LH_COMPLEX_API_URL=https://api.odcloud.kr/api/15080989/v1/uddi:766529e1-96ec-479c-9f75-8e750d69dfcb
MOLIT_COMPLEX_LIST_API_URL=https://apis.data.go.kr/1613000/AptListService3/getTotalAptList3
MOLIT_COMPLEX_BASIC_API_URL=https://apis.data.go.kr/1613000/AptBasisInfoServiceV4/getAphusBassInfoV4
KAPT_MAINTENANCE_COST_API_URL=https://apis.data.go.kr/1613000/AptCmnuseManageCostServiceV2/getHsmpElevatorMntncCostInfoV2
KMA_VILAGE_FORECAST_API_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getVilageFcst
KMA_ASOS_HOURLY_API_URL=https://apis.data.go.kr/1360000/AsosHourlyInfoService/getWthrDataList
SEOUL_RAINFALL_API_URL=http://openapi.seoul.go.kr:8088/{key}/json/ListRainfallService/{start}/{end}/
SEOUL_SEWER_LEVEL_API_URL=http://openapi.seoul.go.kr:8088/{key}/json/DrainpipeMonitoringInfo/{start}/{end}/{district_code}/{start_time}/{end_time}
SEOUL_SEWER_DISTRICT_CODE=01
SEOUL_SEWER_START_TIME=auto-6h
SEOUL_SEWER_END_TIME=auto
SEOUL_FLOOD_FORECAST_MAP_API_URL=http://openapi.seoul.go.kr:8088/{key}/json/floodingDs/{start}/{end}/
# 승인 문서에 표시된 실제 서비스 URL을 입력합니다. 확인되지 않은 URL은 추정하지 않습니다.
SEOUL_RAIN_GAUGE_LOCATION_API_URL=
SEOUL_PUMP_STATION_ATTRIBUTE_API_URL=
SEOUL_RIVER_LEVEL_API_URL=
# 침수예상도 API가 WKT/GeoJSON Geometry를 반환할 때 공식 메타데이터의 CRS 입력
SEOUL_FLOOD_FORECAST_GEOMETRY_SOURCE_CRS=
MOIS_FLOOD_TRACE_PORTAL_URL=https://www.safetydata.go.kr/disaster-data/view?dataSn=108
# 재난안전데이터공유플랫폼에서 승인된 침수흔적도 전용 인증키
MOIS_FLOOD_TRACE_API_KEY=
MOIS_FLOOD_TRACE_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-00117
ELEVATOR_BUILDING_COORD_API_URL=https://api.odcloud.kr/api/15156424/v1/uddi:1e814849-40f9-4599-8c8d-a9ab7ecaf25a
ELEVATOR_INSPECTION_API_URL=https://api.odcloud.kr/api/15112639/v1/uddi:bc8773d6-761e-4174-a5af-87f19202071a
ELEVATOR_CORRECTIVE_ACTION_API_URL=https://api.odcloud.kr/api/15156430/v1/uddi:153fa8ab-c089-4a81-b47f-83bd1b7482cf

RAW_DATA_DIR=data/raw
STAGING_DATA_DIR=data/staging
PROCESSED_DATA_DIR=data/processed
QUARANTINE_DATA_DIR=data/quarantine
ARCHIVE_DATA_DIR=data/archive
# 전체 정제 데이터는 Parquet에 보존하고, API 미리보기용 최신 건수만 SQLite에 유지합니다.
SOURCE_RECORD_SAMPLE_LIMIT=100
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
REPORT_OUTPUT_DIR=artifacts/reports
MODEL_OUTPUT_DIR=artifacts/models
